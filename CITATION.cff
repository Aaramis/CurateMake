cff-version: 1.2.0
title: "CurateMake: a reproducible Snakemake workflow for curating and validating ITS reference sequences"
message: "If you use this software, please cite it using the metadata below."
type: software
authors:
  - given-names: Auguste
    family-names: Gardette
    email: auguste.gardette@gmail.com
    affiliation: "UMMISCO, Institut de Recherche pour le Développement (IRD), France"
    # orcid: "https://orcid.org/0000-0000-0000-0000"   # TODO: add your ORCID iD
  # TODO: add co-authors / supervisors in submission order, e.g.:
  # - given-names: ""
