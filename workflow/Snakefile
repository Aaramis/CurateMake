# workflow/Snakefile
"""
Production-grade ITS pipeline with optional SQLite/PostgreSQL backends.
Processes heterogeneous sequence datasets (UNITE, BOLD, PLANiTS, etc.)
with full traceability and validation.
"""

import os
from datetime import datetime
from pathlib import Path
from dotenv import load_dotenv

# Snakemake executes rules inside dedicated conda envs: keep the host PYTHONPATH
# from leaking into those envs, otherwise their site-packages get shadowed
# (e.g. psycopg2 coming from the dev env instead of the rule env).
os.environ.pop("PYTHONPATH", None)

# Some developer shells keep a local virtualenv (.venv) active which overrides
# `python` even after Snakemake activates a rule-specific conda env. Remove any
# existing virtualenv markers and PATH entries so that `python` resolves to the
# correct snakemake conda env binary when jobs run.
if "VIRTUAL_ENV" in os.environ:
    venv_path = Path(os.environ.pop("VIRTUAL_ENV"))
    venv_bin = str(venv_path / "bin")
    path_entries = [p for p in os.environ.get("PATH", "").split(":") if p and p != venv_bin]
    os.environ["PATH"] = ":".join(path_entries)

# Load .env (project root)
load_dotenv(".env")

# Expand environment variables inside the config dict
def expand_env_vars(config_dict, parent_key=None):
    """Recursively replace environment variable placeholders."""
    import re

    if isinstance(config_dict, dict):
        return {k: expand_env_vars(v, k) for k, v in config_dict.items()}
    elif isinstance(config_dict, list):
        return [expand_env_vars(item, parent_key) for item in config_dict]
    elif isinstance(config_dict, str):
        # Support pour ${VAR} et {{ env.VAR }}
        # ${VAR}
        match = re.match(r'\$\{([^}]+)\}', config_dict)
        if match:
            var_name = match.group(1).strip()
            value = os.getenv(var_name)
            if value is None:
                raise ValueError(f"Environment variable {var_name} not found")
            # Convertir en int si c'est un port
            if parent_key == "port":
                return int(value)
            return value
        # {{ env.VAR }}
        match = re.match(r'\{\{\s*env\.([^}]+)\s*\}\}', config_dict)
        if match:
            var_name = match.group(1).strip()
            value = os.getenv(var_name)
            if value is None:
                raise ValueError(f"Environment variable {var_name} not found")
            # Convertir en int si c'est un port
            if parent_key == "port":
                return int(value)
            return value
    return config_dict

# Charger et configurer le fichier YAML via Snakemake (supporte --config/--configfile)
configfile: "config/config.yaml"

# Substituer les variables d'environnement
config = expand_env_vars(config)

# Variables globales
DATABASES = list(config["databases"].keys())
TIMESTAMP = datetime.now().strftime("%Y%m%d_%H%M%S")

MAX_SATIVA_JOBS = max(1, int(config.get("sativa", {}).get("max_parallel_jobs", 1)))

# Validation de la configuration
if not DATABASES:
    raise ValueError("No databases defined in configuration")

# Inclusion des fonctions communes
include: "rules/common.smk"

# Inclusion des règles modulaires
include: "rules/database.smk"
include: "rules/format_databases.smk"
include: "rules/harmonize_taxo.smk"
include: "rules/itsx.smk"
include: "rules/msa.smk"
include: "rules/sativa.smk"
include: "rules/benchmarking.smk"
include: "rules/reports.smk"

# Règle par défaut
rule all:
    input:
        config["sativa"]["visualization_report"],  # SATIVA visualization report
        config["sativa_integration"]["reporting"]["output_dir"] + "/sativa_integration_report.json",  # SATIVA integration report

        # Rapports HTML
        config["msa"]["output_report"],              # MSA analysis report
        "reports/html/sequence_flow_report.html",    # Sequence flow report
        "reports/html/benchmark_report.html",        # Benchmark report
        "reports/html/sativa_taxonomy_report.html",  # SATIVA taxonomy report with 4-way comparison
        "reports/html/index.html"                    # Index des rapports (runs last)


# Règle de nettoyage
rule clean:
    """Supprime les fichiers temporaires générés dans data/processed (non interactif)."""
    params:
        paths=["data/processed"]
    run:
        import shutil
        from pathlib import Path

        for raw_path in params.paths:
            path = Path(raw_path)
            if not path.exists():
                continue
            if path.is_dir():
                shutil.rmtree(path)
            else:
                path.unlink()
        Path("data/processed").mkdir(parents=True, exist_ok=True)


rule clean_all:
    """Supprime les artéfacts principaux du pipeline de manière contrôlée."""
    params:
        paths=[
            "data/processed",
            "data/db",
            "data/validation",
            "data/ITSx",
            "results",
            "logs",
        ]
    run:
        import shutil
        from pathlib import Path

        for raw_path in params.paths:
            path = Path(raw_path)
            if not path.exists():
                continue
            if path.is_dir():
                shutil.rmtree(path)
            else:
                path.unlink()

# Règle de validation
rule validate:
    """Valide la configuration et les dépendances"""
    log:
        "logs/validation.log"
    script:
        "scripts/validate_setup.py"
