# Règle de validation
rule validate:
    """Valide la configuration et les dépendances"""
    log:
        "logs/validation.log"
    script:
        "scripts/validate_setup.py"

# Pipeline minimal - Base de données seulement
rule database_only:
    """Initialise seulement la base de données."""
    input:
        "data/pipeline.db",
